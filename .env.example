# field-agent environment. Copy to .env for local development without Docker
# (`docker compose up` needs no .env at all: every service carries defaults).

NODE_ENV="development"
LOG_LEVEL="info"

# --- datastores ---------------------------------------------------------------
# Host ports are 5433/6380 to avoid clashing with a local Postgres/Redis.
DATABASE_URL="postgres://fieldagent:fieldagent@localhost:5433/fieldagent"
# Neon direct (non-pooled) URL for migrations on Railway; leave empty locally.
DATABASE_URL_UNPOOLED=""
REDIS_URL="redis://localhost:6380"

# --- api ----------------------------------------------------------------------
API_PORT="4000"
API_HOST="0.0.0.0"
# Comma-separated origins allowed by CORS and trusted by auth.
WEB_ORIGIN="http://localhost:3000"
# false = the brief's local mode: every route open, request.user is null.
# true  = the deployed demo: POST /scrape, POST /verify, /admin/* and the UI need a session.
AUTH_REQUIRED="false"
# openssl rand -base64 32
BETTER_AUTH_SECRET="dev-only-secret-change-me-please-32chars"
# The API's own origin. Better Auth derives its base path from it, and the web app reaches it through /backend.
BETTER_AUTH_URL="http://localhost:4000"
# Password for the seeded demo accounts (see README "Demo accounts").
SEED_DEMO_PASSWORD="FieldAgent-Demo-2026!"
# Enqueue one scrape on first boot if no scrape has ever completed. Restarts never re-hit the portal.
SCRAPE_ON_BOOT="true"
# Global rate limit per IP per minute (POST /scrape and /verify are 10/min).
RATE_LIMIT_MAX="120"

# --- web ----------------------------------------------------------------------
WEB_PORT="3000"
# Server-side base URL of the API as seen from the web container/process.
API_URL="http://localhost:4000"
# Public API origin used for links the browser opens directly (Bull Board from the admin page).
NEXT_PUBLIC_API_URL="http://localhost:4000"

# --- scraper / worker -----------------------------------------------------------
PORTAL_ID="briargate"
# http | playwright  (playwright needs: docker compose --profile browser up)
SCRAPE_ENGINE="http"
SCRAPE_USER_AGENT="FieldAgentBot/0.1 (+https://github.com/Alabs02/field-agent; alabson.inc@gmail.com)"
# robots.txt asks Crawl-delay: 60. Production sets 60000 (~50 min per full run).
# 2000 locally means ~2 minutes and is documented in ASSUMPTIONS.md.
SCRAPE_MIN_DELAY_MS="2000"
# true = effective delay is max(SCRAPE_MIN_DELAY_MS, robots Crawl-delay). Set true in production.
SCRAPE_RESPECT_CRAWL_DELAY="false"
SCRAPE_FETCH_TIMEOUT_MS="20000"
# Per-attempt job timeout; a full polite run takes ~50 min, so 90 min.
SCRAPE_JOB_TIMEOUT_MS="5400000"
VERIFY_JOB_TIMEOUT_MS="1800000"
# Share (0..1) of unflagged promotions whose detail page is re-fetched during verification.
VERIFY_SAMPLE_RATE="0.2"
# Re-fetch a brand's store page when older than this.
BRAND_REFRESH_HOURS="24"
# first | changed | all | off — when to store raw HTML snapshots.
SNAPSHOT_MODE="changed"
WORKER_CONCURRENCY="1"
