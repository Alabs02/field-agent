{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BullMQ workers for scrape and verification jobs.",
  "scripts": {
    "dev": "tsx --env-file-if-exists=../../.env watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@field-agent/db": "workspace:*",
    "@field-agent/queue": "workspace:*",
    "@field-agent/scraper": "workspace:*",
    "@field-agent/shared": "workspace:*",
    "bullmq": "^6.3.6",
    "cheerio": "^1.2.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.1",
    "got-scraping": "^4.2.1",
    "he": "^1.2.0",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "robots-parser": "^3.0.1",
    "sanitize-html": "^2.17.7",
    "tough-cookie": "^6.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  }
}
