{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify API: typed routes, job enqueueing, run status, verification reports, auth.",
  "scripts": {
    "dev": "tsx --env-file-if-exists=../../.env watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "cli": "tsx --env-file-if-exists=../../.env src/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.1",
    "@bull-board/fastify": "^9.10.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/under-pressure": "^9.1.0",
    "@field-agent/db": "workspace:*",
    "@field-agent/queue": "workspace:*",
    "@field-agent/shared": "workspace:*",
    "better-auth": "^1.7.4",
    "bullmq": "^6.3.6",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.4",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  }
}
